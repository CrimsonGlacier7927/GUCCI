worker_processes 1;
events { worker_connections 1024; }

http {
    # ارتقای اتصال WebSocket
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # پروتکل واقعی: اگر Railway (یا پروکسی جلویی) هدر X-Forwarded-Proto را فرستاده
    # (مثلاً https) آن را حفظ کن، وگرنه از scheme اتصال استفاده کن
    map $http_x_forwarded_proto $real_scheme {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    tcp_nodelay on;

    # ================= سرور اصلی =================
    # روی پورت 1 و 3000 گوش می‌دهد تا فرقی نکند Railway دامنه را به کدام پورت
    # فوروارد کند (در داشبورد هر عددی ست شده باشد، nginx همه‌چیز را مدیریت می‌کند)
    server {
        listen 1;
        listen ${NGINX_PORT};
        # ریدایرکت‌ها نسبی بمانند تا پورت داخلی لو نرود
        absolute_redirect off;

        # ریشه دامنه -> صفحه کاملاً سیاه (پنل مخفی می‌ماند)
        location = / {
            default_type text/html;
            return 200 '<!DOCTYPE html><html><head><title></title></head><body style="margin:0;padding:0;background:#000000;width:100vw;height:100vh;"></body></html>';
        }

        # /gucci بدون اسلش -> ریدایرکت به /gucci/
        location = /gucci {
            return 301 /gucci/;
        }

        # پنل 3x-ui -> پورت داخلی 2053 (فقط با مسیر /gucci/ باز می‌شود)
        location /gucci/ {
            proxy_pass http://127.0.0.1:2053/gucci/;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

        # سابسکریپشن (سرویس ساب روی پورت داخلی 2097)
        location /sub/ {
            proxy_pass http://127.0.0.1:443/sub/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

        # ساب JSON
        location /json/ {
            proxy_pass http://127.0.0.1:443/json/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

        # ساب Clash
        location /clash/ {
